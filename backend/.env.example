# Application environment: development | testing | production
# This is read by create_app() to select the active config.
APP_ENV=development

# Flask
FLASK_APP=wsgi.py
FLASK_DEBUG=1

# --- Secrets (REQUIRED in production; generate with
#   python -c "import secrets; print(secrets.token_hex(32))" ) ---
SECRET_KEY=dev-only-change-me
JWT_SECRET_KEY=dev-only-change-me-too

# Database URI. Production examples:
#   PostgreSQL:  postgresql://user:pass@host:5432/dbname
#   MariaDB:     mysql+pymysql://user:pass@host:3306/dbname
#   SQLite (dev/testing):
#     sqlite:///<abs path>/scirp.db
DATABASE_URL=sqlite:///scirp.db

# SMTP for notification emails. Leave SMTP_HOST unset in development to
# print emails to the console instead. In production these are NOT read
# unless set (no PII goes to logs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=