# Base URL of the backend API. Use "/api" when served behind same-origin
# proxy (nginx/vite dev proxy). For a standalone frontend pointing at a
# deployed backend, set e.g. https://civicpulse-backend.onrender.com/api
VITE_API_BASE=/api

# Show the demo-accounts quick-login panel on /login.
# Set to true only for demo/staging deployments. Omit or set false for prod.
VITE_ENABLE_DEMO_ACCOUNTS=true